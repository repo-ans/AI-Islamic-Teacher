# ── Frontend (exposed to the browser — public values only) ─────────────
# Leave both Supabase values empty to run in local DEMO MODE (data in localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true once the `tts` edge function is deployed with an ElevenLabs/Azure key: the teacher
# speaks in that voice (cached server-side — each sentence is billed once).
VITE_TTS_ENABLED=false

# ── Seed script only (never prefix with VITE_) ────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
