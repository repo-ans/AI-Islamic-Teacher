# ── Frontend (exposed to the browser — public values only) ─────────────
# Leave both Supabase values empty to run in local DEMO MODE (data in localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true once the `tts` edge function is deployed with an ElevenLabs/Azure key: admins can
# narrate segments once (stored MP3, replayed free by every student).
VITE_TTS_ENABLED=false
# Also synthesise un-narrated segments live for each student. Bills per play — keep false.
# (Needs the TTS_ALLOW_STUDENTS=true secret on the function as well.)
VITE_TTS_LIVE=false

# ── Seed script only (never prefix with VITE_) ────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
