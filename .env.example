# ── Frontend (exposed to the browser — public values only) ─────────────
# Leave both Supabase values empty to run in local DEMO MODE (data in localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true once the `tts` edge function is deployed with an ElevenLabs/Azure key.
# Otherwise narration falls back to the browser's built-in speech voice.
VITE_TTS_ENABLED=false

# ── Seed script only (never prefix with VITE_) ────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
